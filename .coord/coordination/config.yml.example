# Coordination System Config
# 모든 스크립트/명령이 이 파일을 참조함
# `coordination/config.yml.example` 를 `coordination/config.yml` 로 복사 후 프로젝트에 맞게 수정
#
# 아래 주석에 [DEALOS 예시] 로 표기된 값들은 원본 프로젝트 설정 — 참고용

project:
  name: my-project              # [DEALOS 예시] dealos — worktree 디렉토리명에 사용 (../<name>-wt-<sub>/)

git:
  # 작업 통합 브랜치 (op 가 머지하는 정본)
  work_branch: main             # [DEALOS 예시] 3dview
  # 안정/배포 브랜치 (협업자 협의 후 수동 머지만)
  stable_branch: main           # [DEALOS 예시] main
  # 원격 이름
  remote: origin

# Sub 구성 — 자유 추가/제거 가능
# 각 sub 는 별도 worktree (../<project>-wt-<name>) + branch (wt/<name>)
# scope_allowed 는 glob 패턴 (pre-commit hook 이 범위 밖 커밋 차단)
subs:
  - name: db
    port: 3001
    model: claude-sonnet-4-6
    # 이 sub 의 작업 허용 경로 (pre-commit hook 검증)
    scope_allowed:
      - "db/**"
      # [DEALOS 예시]
      # - "supabase/**"
      # - "lib/supabase*.ts"
      # - "types/supabase.ts"
    validation: "npm run type-check"

  - name: backend
    port: 3002
    model: claude-opus-4-7
    scope_allowed:
      - "src/**"
      # [DEALOS 예시]
      # - "core/**"
      # - "utils/**"
      # - "__tests__/core/**"
    validation: "npm run type-check"

  - name: frontend
    port: 3003
    model: claude-sonnet-4-6
    scope_allowed:
      - "app/**"
      - "components/**"
      # [DEALOS 예시]
      # - "hooks/**"
      # - "stores/**"
      # - "styles/**"
      # - "tailwind.config.*"
    validation: "npm run type-check && npm run lint"

# Head 세션 설정
head:
  port: 3099
  model: claude-opus-4-7
  branch: wt/head

# 메인 세션 (op)
op:
  port: 3000

# 모니터링 / 알림
notifications:
  # Discord webhook URL 은 .env.local 의 DISCORD_WEBHOOK_URL 환경변수 사용 (파일에 직접 쓰지 말 것)
  discord_webhook_env: DISCORD_WEBHOOK_URL
  # 토큰 % 임계값 (높을수록 우선)
  token_thresholds: [10, 20, 30, 40, 50, 60, 70, 80, 90, 95, 96, 97, 98, 99]
  # 매주 리셋 요일/시간 (KST)
  weekly_reset_day: monday
  weekly_reset_hour_kst: 0

# 토큰 예산 (주간)
token_budget:
  weekly_limit: 5000000

# 사법부 (Phase 2.5 — PreToolUse 판사)
judiciary:
  enabled: true
  # 3심 LLM 판사 모델
  judge_model: claude-sonnet-4-6
  # 2.5심 approval 효력 (분) — op 가 승인한 action 은 이 기간 동안 유효
  approval_ttl_minutes: 1440  # 24시간

# 대시보드 (Phase 3)
dashboard:
  enabled: true
  port: 8888
  # 외부 노출 방식: trycloudflare | tailscale | none
  external: trycloudflare

# 머지 전략
merge:
  # sub → work_branch: 자동 (메인이 /review-inbox 에서)
  to_work_branch: auto
  # work_branch → stable_branch: 수동 전용 (협업자 협의)
  to_stable_branch: manual