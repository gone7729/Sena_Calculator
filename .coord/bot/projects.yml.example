# coord Discord Bot 레지스트리 (Phase 6+)
# `bot/projects.yml` 로 복사 후 사용 (gitignored — 사용자 로컬)
#
# v0.7+: 봇 명령 (@bot register / @bot reload 등) 으로도 관리 가능.
# 단, 봇 명령으로 저장하면 이 주석들은 사라짐 (PyYAML 제약).

bot:
  # 봇 명령 실행 허용 user id 목록
  # Discord → Settings → Advanced → Developer Mode ON 후 유저 우클릭 → Copy User ID
  # 비어있으면 아무나 사용 가능 (비공개 서버만 OK, 공개 서버는 반드시 채움)
  admin_user_ids:
    - "000000000000000000"   # 본인 Discord user ID 로 교체

  # 봇이 반응할 채널 id (비우면 mention 한 모든 채널)
  allowed_channel_ids: []

  # 기본 프로젝트 — `@bot <text>` 시 채널 바인딩 없으면 여기로 fallback
  # 없어도 됨 (그러면 채널 바인딩된 프로젝트만 작동)
  default_project: my-project

  # v0.9+: ccusage 기반 자동 경고 (선택)
  # Claude CLI 전체 사용량이 임계 초과 시 지정 채널에 Discord 메시지 발송.
  # 임계 0 이면 해당 체크 비활성. 하루/한달 1회만 알림 (state 는 bot/usage-alerts-state.json).
  usage_alerts:
    enabled: false                        # true 로 바꿔야 작동
    check_interval_minutes: 60            # 체크 주기 (분, 최소 1)
    alert_channel_id: ""                  # 알림 보낼 채널 ID (빈 값이면 작동 안 함)
    daily_usd_threshold: 10.0             # 오늘 누적 $X 초과 시 알림 (0 = 비활성)
    monthly_usd_threshold: 100.0          # 이번 달 누적 $X 초과 시 알림 (0 = 비활성)

  # v0.16+: Option C — @bot <text> 자연어 대화 (Anthropic SDK 직결)
  # 대화방 (discord_channel_id) 에서 send/review/fix 등 명령 없이 @bot 만 하고 자유 텍스트
  # → 봇이 프로젝트 상태 (inbox/STATUS/HEAD_LOCK/verdict) 를 system prompt 에 번들해 Claude API 에 질의 후 응답.
  # ANTHROPIC_API_KEY 환경변수 필요 (.env.local 에 기록). 키 없으면 자동 비활성.
  # 작업장 (discord_alert_channel_id) 에선 동작 안 함 — work 지시는 `@bot send` 사용.
  chat:
    enabled: true                         # false 로 하면 기존 fallback 안내만
    model: "claude-sonnet-4-6"            # 기본 Sonnet 4.6 (빠르고 저렴). "claude-opus-4-7" / "claude-haiku-4-5" 가능
    max_tokens: 1024                      # 응답 최대 토큰 (Discord 메시지 2000자 고려해 짧게)
    include_status_md: true               # STATUS.md 요약을 context 에 포함 (토큰 증가)
    include_recent_inbox: 3               # 최근 inbox 몇 개 제목/status 를 context 에 포함 (0 = 없음)

projects:
  # 예시 1: flat 모드로 설치된 프로젝트
  - id: my-project
    path: /path/to/my-project        # Windows: c:/Users/you/projects/my-project
    enabled: true

    # (선택) 대화방 — 봇 @mention 을 받는 채널 id
    # 비우면 mention 한 모든 채널에서 반응
    # discord_channel_id: "1234567890123456789"

    # (선택, v0.11+) 작업장 — webhook 알림 + inbox thread 가 모이는 채널
    # 설정하면:
    #   - Worker 가 spawn 결과 "anchor" 메시지 + thread 를 이 채널에 생성
    #   - head 의 webhook 알림도 이 채널 webhook URL 로 오도록 .env.local 에 DISCORD_WEBHOOK_URL 설정
    #   - 리액션 escalation 응답도 이 채널 메시지에서 처리
    # 비우면 명령이 온 채널에 그대로 (v0.10 동작)
    # discord_alert_channel_id: "9876543210987654321"

  # 예시 2: subdir (subtree) 모드로 설치된 프로젝트 — path 는 PROJECT_ROOT 지정
  # - id: other-project
  #   path: /path/to/other-project
  #   enabled: true
  #   discord_channel_id: "..."
  #   discord_alert_channel_id: "..."
