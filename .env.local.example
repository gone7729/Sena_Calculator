# coord 환경변수 템플릿
# 프로젝트 루트에 `.env.local` 로 복사 후 값 채우기
# 대부분 스크립트는 이 파일을 자동 로드하지 않음 → `source .env.local` 필요

# === Discord (선택) ===
# Server Settings → Integrations → Webhooks 에서 생성
DISCORD_WEBHOOK_URL=

# === Discord Bot (Phase 6 — 선택) ===
# Developer Portal (https://discord.com/developers/applications) → Bot → Reset Token
# ⚠ 절대 .env.local.example 에 실제 토큰 넣지 말 것 (tracked 파일)
# Privileged Gateway Intents 에서 "Message Content Intent" 활성화 필수
DISCORD_BOT_TOKEN=

# === Anthropic API (v0.16 Option C — 자연어 대화, 선택) ===
# @bot <text> (send/기타 명령 없이) 를 대화방에서 자연어 대화로 처리.
# https://console.anthropic.com/ → API Keys → Create Key
# 키 없으면 자동 비활성 (기존 fallback 안내만 표시)
ANTHROPIC_API_KEY=

# === GitHub (선택, 알림 링크용) ===
GITHUB_REPO_URL=

# === Claude 모델 오버라이드 (선택) ===
# 기본값은 coordination/config.yml 에서 읽음
# CLAUDE_HEAD_MODEL=claude-opus-4-7
# CLAUDE_JUDGE_MODEL=claude-sonnet-4-6

# === Dashboard (선택) ===
# DASHBOARD_PORT=8888

# === Cloudflare Tunnel (선택, 이름있는 터널 사용 시) ===
# TryCloudflare 는 계정/토큰 불필요 — 이 값은 named tunnel 쓸 때만
# CLOUDFLARE_TUNNEL_TOKEN=
