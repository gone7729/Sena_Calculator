<Window x:Class="GameDamageCalculator.UI.SimulatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="배틀 시뮬레이터 &amp; 장비 옵티마이저"
        Height="900" Width="1400"
        Background="#14161b"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <SolidColorBrush x:Key="AccentCharacter" Color="#818cf8"/>
        <SolidColorBrush x:Key="AccentEquipment" Color="#f59e0b"/>
        <SolidColorBrush x:Key="AccentBoss" Color="#fb923c"/>
        <SolidColorBrush x:Key="AccentResult" Color="#34d399"/>
        <SolidColorBrush x:Key="AccentFormation" Color="#06b6d4"/>
        <SolidColorBrush x:Key="AccentPet" Color="#10b981"/>

        <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#6366f1" Offset="0"/>
            <GradientStop Color="#8b5cf6" Offset="1"/>
        </LinearGradientBrush>

        <!-- 공통 스타일: 섹션 헤더 -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- 공통 스타일: 라벨 -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#94a3b8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 공통 스타일: 콤보박스 -->
        <Style x:Key="DarkCombo" TargetType="ComboBox">
            <Setter Property="Background" Value="#1e2028"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2d2f3a"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>

        <!-- 공통 스타일: 카드 패널 -->
        <Style x:Key="CardPanel" TargetType="Border">
            <Setter Property="Background" Value="#1a1c24"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="4"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 상단: 제목 -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryGradient}" CornerRadius="8" Padding="12" Margin="0,0,0,8">
            <TextBlock Text="⚔ 배틀 시뮬레이터 &amp; 장비 옵티마이저"
                       FontSize="18" FontWeight="Bold" Foreground="White"/>
        </Border>

        <!-- 중앙: 메인 콘텐츠 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 좌측: 설정 패널 -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- 보스 선택 -->
                    <Border Style="{StaticResource CardPanel}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionHeader}">
                                <Run Foreground="{StaticResource AccentBoss}" Text="●"/>
                                <Run Text=" 보스 선택"/>
                            </TextBlock>
                            <ComboBox x:Name="BossTypeCombo" Style="{StaticResource DarkCombo}"
                                      SelectionChanged="BossTypeCombo_SelectionChanged"/>
                            <ComboBox x:Name="BossCombo" Style="{StaticResource DarkCombo}" Margin="0,4"
                                      SelectionChanged="BossCombo_SelectionChanged"/>
                        </StackPanel>
                    </Border>

                    <!-- 진형 선택 -->
                    <Border Style="{StaticResource CardPanel}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionHeader}">
                                <Run Foreground="{StaticResource AccentFormation}" Text="●"/>
                                <Run Text=" 진형"/>
                            </TextBlock>
                            <ComboBox x:Name="FormationCombo" Style="{StaticResource DarkCombo}"/>
                        </StackPanel>
                    </Border>

                    <!-- 펫 선택 -->
                    <Border Style="{StaticResource CardPanel}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionHeader}">
                                <Run Foreground="{StaticResource AccentPet}" Text="●"/>
                                <Run Text=" 펫"/>
                            </TextBlock>
                            <ComboBox x:Name="PetCombo" Style="{StaticResource DarkCombo}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Style="{StaticResource LabelStyle}" Text="성급: "/>
                                <ComboBox x:Name="PetStarCombo" Style="{StaticResource DarkCombo}" Width="60"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 파티 캐릭터 5명 -->
                    <Border Style="{StaticResource CardPanel}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionHeader}">
                                <Run Foreground="{StaticResource AccentCharacter}" Text="●"/>
                                <Run Text=" 파티 구성 (5명)"/>
                            </TextBlock>

                            <!-- 캐릭터 1 -->
                            <Border Background="#22242e" CornerRadius="4" Padding="8" Margin="0,2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="1." Foreground="#818cf8" FontWeight="Bold"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox Grid.Column="1" x:Name="Char1Combo" Style="{StaticResource DarkCombo}"/>
                                    <CheckBox Grid.Column="2" x:Name="Char1Back" Content="후열"
                                              Foreground="#94a3b8" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>
                            </Border>

                            <!-- 캐릭터 2 -->
                            <Border Background="#22242e" CornerRadius="4" Padding="8" Margin="0,2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="2." Foreground="#818cf8" FontWeight="Bold"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox Grid.Column="1" x:Name="Char2Combo" Style="{StaticResource DarkCombo}"/>
                                    <CheckBox Grid.Column="2" x:Name="Char2Back" Content="후열"
                                              Foreground="#94a3b8" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>
                            </Border>

                            <!-- 캐릭터 3 -->
                            <Border Background="#22242e" CornerRadius="4" Padding="8" Margin="0,2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="3." Foreground="#818cf8" FontWeight="Bold"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox Grid.Column="1" x:Name="Char3Combo" Style="{StaticResource DarkCombo}"/>
                                    <CheckBox Grid.Column="2" x:Name="Char3Back" Content="후열"
                                              Foreground="#94a3b8" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>
                            </Border>

                            <!-- 캐릭터 4 -->
                            <Border Background="#22242e" CornerRadius="4" Padding="8" Margin="0,2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="4." Foreground="#818cf8" FontWeight="Bold"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox Grid.Column="1" x:Name="Char4Combo" Style="{StaticResource DarkCombo}"/>
                                    <CheckBox Grid.Column="2" x:Name="Char4Back" Content="후열"
                                              Foreground="#94a3b8" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>
                            </Border>

                            <!-- 캐릭터 5 -->
                            <Border Background="#22242e" CornerRadius="4" Padding="8" Margin="0,2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="5." Foreground="#818cf8" FontWeight="Bold"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox Grid.Column="1" x:Name="Char5Combo" Style="{StaticResource DarkCombo}"/>
                                    <CheckBox Grid.Column="2" x:Name="Char5Back" Content="후열"
                                              Foreground="#94a3b8" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 설정 -->
                    <Border Style="{StaticResource CardPanel}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionHeader}" Text="설정"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Style="{StaticResource LabelStyle}" Text="최대 턴: " Width="80"/>
                                <TextBox x:Name="MaxTurnsBox" Text="40" Width="60"
                                         Background="#1e2028" Foreground="White" BorderBrush="#2d2f3a"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Style="{StaticResource LabelStyle}" Text="서브옵 총 티어: " Width="80"/>
                                <TextBox x:Name="MaxSubTiersBox" Text="64" Width="60"
                                         Background="#1e2028" Foreground="White" BorderBrush="#2d2f3a"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 우측: 결과 패널 -->
            <Grid Grid.Column="1" Margin="8,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 총 데미지 -->
                <Border Grid.Row="0" Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}">
                            <Run Foreground="{StaticResource AccentResult}" Text="●"/>
                            <Run Text=" 시뮬레이션 결과"/>
                        </TextBlock>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="총 데미지: " Foreground="#94a3b8" FontSize="16"/>
                            <TextBlock x:Name="TotalDamageText" Text="-"
                                       Foreground="#34d399" FontSize="20" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="소요 시간: " Foreground="#64748b" FontSize="12"/>
                            <TextBlock x:Name="ElapsedTimeText" Text="-"
                                       Foreground="#64748b" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 캐릭터별 결과 -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                    <StackPanel x:Name="ResultsPanel"/>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- 하단: 실행 버튼 -->
        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" x:Name="SimulateButton" Content="배틀 시뮬레이션 실행"
                    Height="40" Margin="0,0,4,0"
                    Background="#4f46e5" Foreground="White" FontSize="14" FontWeight="Bold"
                    BorderThickness="0" Cursor="Hand"
                    Click="SimulateButton_Click"/>

            <Button Grid.Column="1" x:Name="OptimizeButton" Content="장비 최적화 실행"
                    Height="40" Margin="4,0,0,0"
                    Background="#059669" Foreground="White" FontSize="14" FontWeight="Bold"
                    BorderThickness="0" Cursor="Hand"
                    Click="OptimizeButton_Click"/>
        </Grid>
    </Grid>
</Window>
